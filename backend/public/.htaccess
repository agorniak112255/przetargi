<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Bledny URL (stary path) -> kanoniczny
    RewriteRule ^backend/public/?$ / [R=302,L,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Istniejace pliki (assets, index.html, index.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- API -> Laravel ---
    # XAMPP: Alias /Przetargi -> backend/public (nie uzywac RewriteBase /)
    RewriteCond %{REQUEST_URI} ^/Przetargi/api
    RewriteRule ^api(?:/.*)?$ /Przetargi/index.php [L,END]

    # Produkcja: DocumentRoot = backend/public
    RewriteCond %{REQUEST_URI} !^/Przetargi/
    RewriteRule ^api(?:/.*)?$ index.php [L,END]

    # --- SPA (React Router) ---
    RewriteCond %{REQUEST_URI} ^/Przetargi/
    RewriteRule ^ /Przetargi/index.html [L,END]

    RewriteCond %{REQUEST_URI} !^/Przetargi/
    RewriteRule ^ index.html [L,END]
</IfModule>

DirectoryIndex index.html index.php
