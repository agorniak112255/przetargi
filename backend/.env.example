APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=przetargi
DB_USERNAME=root
DB_PASSWORD=
# Zrzut z serwera do tej bazy: .\deploy\db-pull.ps1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.supon.rzeszow.pl
MAIL_PORT=587
MAIL_USERNAME=przetargi@supon.rzeszow.pl
MAIL_PASSWORD=
MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS="przetargi@supon.rzeszow.pl"
MAIL_FROM_NAME="Przetargi Supon"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (OpenAI-compatible: OpenAI / Azure OpenAI / Groq / vLLM / Ollama proxy)
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=90
# 0 = auto (16128 vLLM, 128000 chmura). Ustaw gdy zmienisz --max-model-len.
AI_MAX_MODEL_LEN=0
AI_TEMPERATURE=0.1
AI_WEB_SEARCH_ENABLED=true
AI_TAVILY_API_KEY=
AI_SEARCH_FALLBACK=tavily

# PrestaShop (read-only) — opisy/zdjęcia ze sklepu, osobny cykl od AI
PRESTA_ENABLED=false
PRESTA_DB_HOST=
PRESTA_DB_PORT=3306
PRESTA_DB_DATABASE=
PRESTA_DB_USERNAME=
PRESTA_DB_PASSWORD=
PRESTA_TABLE_PREFIX=ps_
PRESTA_ID_LANG=1
PRESTA_SHOP_URL=https://supon.rzeszow.pl
PRESTA_WEBSERVICE_KEY=
PRESTA_ID_CATEGORY_DEFAULT=2
PRESTA_DELIVERY_LABEL="Na zamówienie"

# Reader kart zza zapor (r.jina.ai): odstep miedzy wywolaniami dla calego serwera
# i opcjonalny klucz API (bez klucza ~20 zapytan/min).
ENRICHMENT_READER_MIN_INTERVAL=3.5
JINA_API_KEY=

# Brave Search API (darmowy plan: ~2000 zapytan/mies., 1 zapytanie/s).
# Bez klucza silnik jest pomijany.
BRAVE_SEARCH_API_KEY=
