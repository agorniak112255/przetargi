APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=przetargi
DB_USERNAME=root
DB_PASSWORD=
# Zrzut z serwera do tej bazy: .\deploy\db-pull.ps1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Czat i kolejka dodatku do Thunderbirda w czasie rzeczywistym (Laravel Reverb). Bez tego (log) aplikacja i dodatek
# odpytują API — działa, tylko z opóźnieniem. Na produkcji: BROADCAST_CONNECTION=reverb, Reverb jako usługa systemd
# na 127.0.0.1:8080 (aplikacja publikuje tam zdarzenia), a przeglądarki i dodatek łączą się przez nginx Pleska
# (/app i /apps → 127.0.0.1:8080) na porcie 443. Klucze: losowe, ten sam REVERB_APP_KEY widzą klienci (GET /api/realtime).
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# CHAT_WS_HOST=przetargi.supon.rzeszow.pl
# CHAT_WS_PORT=443
# CHAT_WS_SCHEME=https
# Rozmowy głosowe i wideo w czacie (LiveKit). Bez LIVEKIT_URL, klucza i sekretu przyciski „Zadzwoń”/„Wideo” są ukryte.
# Na produkcji LiveKit działa w Dockerze w sieci hosta: przeglądarki łączą się przez nginx (wss://rtc.supon.rzeszow.pl
# → 127.0.0.1:7880), media idą TCP 7881 i UDP 7882–7892, a serwer aplikacji woła API pokojów bezpośrednio
# (LIVEKIT_API_URL). Klucz i sekret te same co w konfiguracji LiveKit (keys:) — sekretem LiveKit podpisuje też webhooki
# wysyłane na https://<adres aplikacji>/api/chat/livekit/webhook.
# LIVEKIT_URL=wss://rtc.supon.rzeszow.pl
# LIVEKIT_API_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_MAX_PARTICIPANTS=50
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Analiza zapytań klientów idzie w tle (worker przetargi-inquiries@). Lokalnie bez workera: sync
# QUEUE_INQUIRIES_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.supon.rzeszow.pl
MAIL_PORT=587
MAIL_USERNAME=przetargi@supon.rzeszow.pl
MAIL_PASSWORD=
MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS="przetargi@supon.rzeszow.pl"
MAIL_FROM_NAME="Przetargi Supon"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (OpenAI-compatible: OpenAI / Azure OpenAI / Groq / vLLM / Ollama proxy)
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=90
# 0 = auto (16128 vLLM, 128000 chmura). Ustaw gdy zmienisz --max-model-len.
AI_MAX_MODEL_LEN=0
AI_TEMPERATURE=0.1
AI_WEB_SEARCH_ENABLED=true
AI_TAVILY_API_KEY=
AI_SEARCH_FALLBACK=tavily

# PrestaShop (read-only) — opisy/zdjęcia ze sklepu, osobny cykl od AI
# Comarch ERP XL (MS SQL, login tylko do odczytu; wymaga rozszerzenia pdo_sqlsrv)
ERPXL_ENABLED=false
ERPXL_DB_HOST=
ERPXL_DB_PORT=1433
ERPXL_DB_DATABASE=CDNXL_SUPON
ERPXL_DB_USERNAME=
ERPXL_DB_PASSWORD=

PRESTA_ENABLED=false
PRESTA_DB_HOST=
PRESTA_DB_PORT=3306
PRESTA_DB_DATABASE=
PRESTA_DB_USERNAME=
PRESTA_DB_PASSWORD=
PRESTA_TABLE_PREFIX=ps_
PRESTA_ID_LANG=1
PRESTA_SHOP_URL=https://supon.rzeszow.pl
PRESTA_WEBSERVICE_KEY=
PRESTA_ID_CATEGORY_DEFAULT=2
PRESTA_DELIVERY_LABEL="Na zamówienie"

# Reader kart zza zapor (r.jina.ai): odstep miedzy wywolaniami dla calego serwera
# i opcjonalny klucz API (bez klucza ~20 zapytan/min).
ENRICHMENT_READER_MIN_INTERVAL=3.5
JINA_API_KEY=

# Brave Search API (darmowy plan: ~2000 zapytan/mies., 1 zapytanie/s).
# Bez klucza silnik jest pomijany.
BRAVE_SEARCH_API_KEY=

# Biuletyn Zamowien Publicznych (bzp:fetch): rozpoznanie wygranej po NIP firmy, potem po nazwie
# (kilka nazw rozdzielonych przecinkiem).
BZP_OUR_NIP=8132283737
BZP_OUR_NAMES=SUPON
